datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String
  aadhaar_hash String
  pan_hash     String
  language     String   @default("English")
  createdAt    DateTime @default(now())

  familyMembers FamilyMember[]
  claims        Claim[]
  aiLogs        AiLog[]
}

model FamilyMember {
  id       String @id @default(uuid())
  userId   String
  name     String
  relation String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeceasedRecord {
  id            String   @id @default(uuid())
  userId        String
  deathDate     DateTime
  certificateId String   @unique
}

model Asset {
  id              String @id @default(uuid())
  deceasedName    String
  type            String
  institution     String
  principal       Float
  accruedInterest Float
  totalValue      Float
  status          String

  claims Claim[]
}

model Claim {
  id                String @id @default(uuid())
  assetId           String
  claimantId        String
  eligibility       String
  monetizationTrack String
  status            String

  asset     Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  claimant  User       @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  documents Document[]
}

model Document {
  id                 String @id @default(uuid())
  claimId            String
  type               String
  fileUrl            String
  verificationStatus String

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model AiLog {
  id        String   @id @default(uuid())
  userId    String
  prompt    String
  response  String
  engine    String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
