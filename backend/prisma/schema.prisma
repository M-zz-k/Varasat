datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String
  passwordHash String
  aadhaarHash  String
  panHash      String
  aadhaarLast4 String
  panLast4     String
  role         String   @default("claimant")
  language     String   @default("English")
  createdAt    DateTime @default(now())

  familyMembers FamilyMember[]
  claims        Claim[]
  aiLogs        AiLog[]
}

model FamilyMember {
  id       String  @id @default(uuid())
  userId   String
  name     String
  relation String
  isLiving Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeceasedRecord {
  id            String   @id @default(uuid())
  userId        String
  deceasedName  String
  deathDate     DateTime
  certificateId String   @unique

  assets Asset[]
}

model Asset {
  id          String @id @default(uuid())
  deceasedId  String
  type        String
  institution String
  amount      Float
  status      String

  deceased DeceasedRecord @relation(fields: [deceasedId], references: [id], onDelete: Cascade)
  claims   Claim[]
}

model Claim {
  id          String @id @default(uuid())
  assetId     String
  claimantId  String
  eligibility String
  track       String
  status      String

  asset     Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  claimant  User       @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  documents Document[]
}

model Document {
  id                 String @id @default(uuid())
  claimId            String
  type               String
  fileUrl            String
  verificationStatus String

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model AiLog {
  id        String   @id @default(uuid())
  userId    String
  prompt    String
  response  String
  engine    String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
