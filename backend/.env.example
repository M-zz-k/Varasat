# Required — app will crash on startup if missing or invalid
JWT_SECRET=           # min 64 chars, random hex
ENCRYPTION_KEY=       # exactly 64 hex chars (32 bytes)
DATABASE_URL=         # PostgreSQL connection string
FRONTEND_URL=         # e.g. https://varasat.in or http://localhost:3000

# Required for production features
CLAUDE_API_KEY=       # Anthropic API key
WOLFRAM_APP_ID=       # Wolfram Cloud App ID
WOLFRAM_API_URL=      # Wolfram API endpoint

# Optional
PORT=5000
NODE_ENV=development
